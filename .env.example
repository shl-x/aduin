# =============================================================================
# Aduin — Environment Variables
# Salin file ini menjadi .env.local dan isi nilainya.
# JANGAN commit .env.local ke version control.
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Langflow ---
LANGFLOW_BASE_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=<langflow-api-key>

# --- Flow IDs (UUID dari URL Langflow setelah flow dibuat) ---
LANGFLOW_FLOW_CLARIFY_ID=<uuid>
LANGFLOW_FLOW_TRIAGE_ID=<uuid>
LANGFLOW_FLOW_EMBED_ID=<uuid>
LANGFLOW_FLOW_OPD_AGENT_ID=<uuid>
LANGFLOW_FLOW_VERIFY_ID=<uuid>
LANGFLOW_FLOW_ALERT_SUMMARY_ID=<uuid>

# --- Embedding ---
# Harus konsisten dengan model di flow aduin-embed di Langflow.
# ibm/granite-embedding-278m-multilingual → 768
EMBEDDING_DIMENSION=768

# --- Clustering ---
CLUSTER_SIMILARITY_THRESHOLD=0.75
CLUSTER_RADIUS_METERS=500
CLUSTER_WINDOW_DAYS=14

# --- Early Warning ---
ALERT_THRESHOLD_Z=2.0
ALERT_MIN_COUNT=3
LANGFLOW_ALERT_TIMEOUT_MS=10000

# --- Demo Mode ---
# Jika true: RoleSwitcher, tombol masuk per role di landing page, dan tombol
# "Reset Demo" aktif. Wajib false di production.
NEXT_PUBLIC_DEMO_MODE=true
# Password semua akun demo. Hanya dibaca server (seed + POST /api/demo/login);
# jangan pernah dijadikan variabel NEXT_PUBLIC_*.
DEMO_SEED_PASSWORD=<kata-sandi-akun-demo>
